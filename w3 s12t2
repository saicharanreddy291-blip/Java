class Solution {
    public String dayOfTheWeek(int day, int month, int year) {

        String[] week = {
            "Sunday", "Monday", "Tuesday",
            "Wednesday", "Thursday", "Friday", "Saturday"
        };

        int totalDays = 0;

        // Add days from previous years
        for (int y = 1971; y < year; y++) {
            if (isLeapYear(y))
                totalDays += 366;
            else
                totalDays += 365;
        }

        // Days in each month
        int[] days = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        // February has 29 days in leap year
        if (isLeapYear(year)) {
            days[1] = 29;
        }

        // Add days from previous months
        for (int m = 0; m < month - 1; m++) {
            totalDays += days[m];
        }

        // Add previous days in current month
        totalDays += day - 1;

        // January 1, 1971 was Friday
        // Friday = index 5
        int dayIndex = (5 + totalDays) % 7;

        return week[dayIndex];
    }

    public boolean isLeapYear(int year) {
        return (year % 400 == 0) ||
               (year % 4 == 0 && year % 100 != 0);
    }
}
