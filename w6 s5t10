import java.io.*;
import java.util.*;

public class Solution {

    /*
     * Segment tree storing the best value for three possible line slopes:
     *
     * slope = -1
     * slope =  0
     * slope = +1
     *
     * Every palindrome contributes a piecewise-linear function to the
     * possible rotation starts.
     */
    static class SegmentTree {
        int n;
        int[] plus;
        int[] zero;
        int[] minus;

        SegmentTree(int n) {
            this.n = n;
            plus = new int[4 * n];
            zero = new int[4 * n];
            minus = new int[4 * n];

            Arrays.fill(plus, Integer.MIN_VALUE);
            Arrays.fill(zero, Integer.MIN_VALUE);
            Arrays.fill(minus, Integer.MIN_VALUE);
        }

        void update(int node, int l, int r,
                    int ql, int qr, int slope, int intercept) {

            if (ql > r || qr < l) {
                return;
            }

            if (ql <= l && r <= qr) {
                if (slope == 1) {
                    plus[node] = Math.max(plus[node], intercept);
                } else if (slope == 0) {
                    zero[node] = Math.max(zero[node], intercept);
                } else {
                    minus[node] = Math.max(minus[node], intercept);
                }
                return;
            }

            int mid = (l + r) / 2;

            update(node * 2, l, mid, ql, qr, slope, intercept);
            update(node * 2 + 1, mid + 1, r, ql, qr,
                   slope, intercept);
        }

        void update(int l, int r, int slope, int intercept) {
            if (l > r || r < 0 || l >= n) {
                return;
            }

            l = Math.max(l, 0);
            r = Math.min(r, n - 1);

            update(1, 0, n - 1, l, r, slope, intercept);
        }

        int query(int node, int l, int r, int x) {

            int best = Integer.MIN_VALUE;

            if (plus[node] != Integer.MIN_VALUE) {
                best = Math.max(best, x + plus[node]);
            }

            if (zero[node] != Integer.MIN_VALUE) {
                best = Math.max(best, zero[node]);
            }

            if (minus[node] != Integer.MIN_VALUE) {
                best = Math.max(best, -x + minus[node]);
            }

            if (l == r) {
                return best;
            }

            int mid = (l + r) / 2;

            if (x <= mid) {
                return Math.max(best,
                        query(node * 2, l, mid, x));
            } else {
                return Math.max(best,
                        query(node * 2 + 1, mid + 1, r, x));
            }
        }

        int query(int x) {
            return query(1, 0, n - 1, x);
        }
    }

    // Manacher: odd length palindromes
    static int[] manacherOdd(String s) {
        int n = s.length();
        int[] d = new int[n];

        int l = 0;
        int r = -1;

        for (int i = 0; i < n; i++) {
            int k;

            if (i > r) {
                k = 1;
            } else {
                k = Math.min(d[l + r - i], r - i + 1);
            }

            while (i - k >= 0 &&
                   i + k < n &&
                   s.charAt(i - k) == s.charAt(i + k)) {
                k++;
            }

            d[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        return d;
    }

    // Manacher: even length palindromes
    static int[] manacherEven(String s) {
        int n = s.length();
        int[] d = new int[n];

        int l = 0;
        int r = -1;

        for (int i = 0; i < n; i++) {
            int k;

            if (i > r) {
                k = 0;
            } else {
                k = Math.min(d[l + r - i + 1], r - i + 1);
            }

            while (i - k - 1 >= 0 &&
                   i + k < n &&
                   s.charAt(i - k - 1) == s.charAt(i + k)) {
                k++;
            }

            d[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }

        return d;
    }

    /*
     * Add all possible odd palindromes centered at i.
     */
    static void addOdd(SegmentTree tree, int i, int radius, int n) {

        int R = radius;

        /*
         * For rotation starting at x:
         *
         * maximum possible radius =
         * min(R, x + n - i, i - x + 1)
         *
         * This function consists of at most three linear pieces.
         */

        int left = i - R + 1;
        int right = i + n - R;

        // Flat part where the complete palindrome fits
        if (left <= right) {
            tree.update(left, right, 0, R * 2 - 1);
        }

        /*
         * Left side:
         * radius = x + n - i
         * length = 2 * radius - 1
         */
        int l1 = i - n + 1;
        int r1 = i - R;

        if (l1 <= r1) {
            tree.update(l1, r1, 1,
                    2 * (n - i) - 1);
        }

        /*
         * Right side:
         * radius = i - x + 1
         * length = 2 * radius - 1
         */
        int l2 = i + n - R + 1;
        int r2 = i;

        if (l2 <= r2) {
            tree.update(l2, r2, -1,
                    2 * i + 1);
        }

        /*
         * When R is larger than the rotation window,
         * the two boundary lines cross without a flat section.
         */
        if (left > right) {

            int middle = (2 * i + 1 - n) / 2;

            int a = i - n + 1;
            int b = Math.min(middle, i);

            if (a <= b) {
                tree.update(a, b, 1,
                        2 * (n - i) - 1);
            }

            int c = Math.max(middle + 1, 0);
            int d = i;

            if (c <= d) {
                tree.update(c, d, -1,
                        2 * i + 1);
            }
        }
    }

    /*
     * Add all possible even palindromes centered between i-1 and i.
     */
    static void addEven(SegmentTree tree, int i, int radius, int n) {

        int R = radius;

        /*
         * Maximum radius fitting inside rotation x:
         *
         * min(R, i - x, x + n - i)
         *
         * palindrome length = 2 * radius
         */

        int left = i - R;
        int right = i + n - R;

        if (left <= right) {
            tree.update(left, right, 0, 2 * R);
        }

        // Increasing side
        int l1 = i - n;
        int r1 = i - R - 1;

        if (l1 <= r1) {
            tree.update(l1, r1, 1,
                    2 * (n - i));
        }

        // Decreasing side
        int l2 = i + n - R + 1;
        int r2 = i - 1;

        if (l2 <= r2) {
            tree.update(l2, r2, -1,
                    2 * i);
        }

        // No flat part
        if (left > right) {

            int middle = (2 * i - n) / 2;

            int a = i - n;
            int b = Math.min(middle, i - 1);

            if (a <= b) {
                tree.update(a, b, 1,
                        2 * (n - i));
            }

            int c = Math.max(middle + 1, 0);
            int d = i - 1;

            if (c <= d) {
                tree.update(c, d, -1,
                        2 * i);
            }
        }
    }

    public static void main(String[] args) throws Exception {

        BufferedReader br =
            new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        /*
         * Double the string.
         *
         * Every circular rotation of s appears as a normal substring
         * of s + s.
         */
        String doubled = s + s;

        int length = doubled.length();

        int[] odd = manacherOdd(doubled);
        int[] even = manacherEven(doubled);

        SegmentTree tree = new SegmentTree(n);

        /*
         * Only centers that can participate in a rotation starting
         * from 0 to n-1 are needed.
         */
        for (int i = 0; i < length; i++) {

            addOdd(tree, i, odd[i], n);

            addEven(tree, i, even[i], n);
        }

        /*
         * Query every possible rotation.
         */
        for (int start = 0; start < n; start++) {
            System.out.println(tree.query(start));
        }
    }
}
