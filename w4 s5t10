import java.io.*;
import java.util.*;

public class Solution {

    public static void matrixRotation(List<List<Integer>> matrix, int r) {
        int m = matrix.size();
        int n = matrix.get(0).size();

        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            int top = layer;
            int left = layer;
            int bottom = m - 1 - layer;
            int right = n - 1 - layer;

            // Store the layer elements in anti-clockwise traversal order
            List<Integer> values = new ArrayList<Integer>();

            // Top -> Bottom (left column)
            for (int i = top; i <= bottom; i++) {
                values.add(matrix.get(i).get(left));
            }

            // Bottom -> Right (bottom row)
            for (int j = left + 1; j <= right; j++) {
                values.add(matrix.get(bottom).get(j));
            }

            // Right -> Top (right column)
            for (int i = bottom - 1; i >= top; i--) {
                values.add(matrix.get(i).get(right));
            }

            // Top -> Left (top row)
            for (int j = right - 1; j > left; j--) {
                values.add(matrix.get(top).get(j));
            }

            int len = values.size();
            int shift = r % len;

            // Put rotated values back into the layer
            int index = shift;

            // Top -> Bottom (left column)
            for (int i = top; i <= bottom; i++) {
                matrix.get(i).set(left, values.get(index));
                index = (index + 1) % len;
            }

            // Bottom -> Right (bottom row)
            for (int j = left + 1; j <= right; j++) {
                matrix.get(bottom).set(j, values.get(index));
                index = (index + 1) % len;
            }

            // Right -> Top (right column)
            for (int i = bottom - 1; i >= top; i--) {
                matrix.get(i).set(right, values.get(index));
                index = (index + 1) % len;
            }

            // Top -> Left (top row)
            for (int j = right - 1; j > left; j--) {
                matrix.get(top).set(j, values.get(index));
                index = (index + 1) % len;
            }
        }

        // Print the result
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(matrix.get(i).get(j));

                if (j < n - 1) {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();
        int r = sc.nextInt();

        List<List<Integer>> matrix = new ArrayList<List<Integer>>();

        for (int i = 0; i < m; i++) {
            List<Integer> row = new ArrayList<Integer>();

            for (int j = 0; j < n; j++) {
                row.add(sc.nextInt());
            }

            matrix.add(row);
        }

        matrixRotation(matrix, r);

        sc.close();
    }
}
