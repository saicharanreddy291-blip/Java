class Solution {

    public int daysBetweenDates(String date1, String date2) {

        int y1 = Integer.parseInt(date1.substring(0, 4));
        int m1 = Integer.parseInt(date1.substring(5, 7));
        int d1 = Integer.parseInt(date1.substring(8, 10));

        int y2 = Integer.parseInt(date2.substring(0, 4));
        int m2 = Integer.parseInt(date2.substring(5, 7));
        int d2 = Integer.parseInt(date2.substring(8, 10));

        return Math.abs(toDays(y1, m1, d1) - toDays(y2, m2, d2));
    }

    public int toDays(int year, int month, int day) {

        int total = 0;

        // Days in previous years
        for (int y = 1; y < year; y++) {
            if (isLeapYear(y))
                total += 366;
            else
                total += 365;
        }

        // Days in previous months
        for (int m = 1; m < month; m++) {
            total += daysInMonth(m, year);
        }

        // Days in current month
        total += day;

        return total;
    }

    public boolean isLeapYear(int year) {
        return (year % 400 == 0) ||
               (year % 4 == 0 && year % 100 != 0);
    }

    public int daysInMonth(int month, int year) {

        int[] days = {
            31, 28, 31, 30, 31, 30,
            31, 31, 30, 31, 30, 31
        };

        if (month == 2 && isLeapYear(year)) {
            return 29;
        }

        return days[month - 1];
    }
}
